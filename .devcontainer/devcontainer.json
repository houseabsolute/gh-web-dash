{
  "name": "gh-web-dash",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "containerUser": "dev",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "postCreateCommand": ".devcontainer/post-create.sh",
  "forwardPorts": [
    8420
  ],
  "mounts": [
    "source=gh-web-dash-gh-auth,target=/home/dev/.config/gh,type=volume",
    "source=${localEnv:HOME}/.config/gh-web-dash,target=/home/dev/.config/gh-web-dash,type=bind"
  ],
  "appPort": [
    "127.0.0.1:8420:8420"
  ]
}
